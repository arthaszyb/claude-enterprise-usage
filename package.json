{
  "name": "claude-enterprise-usage",
  "displayName": "Claude Enterprise Usage",
  "description": "Shows Claude Enterprise member usage in the VS Code status bar.",
  "version": "0.3.1",
  "publisher": "SeanYangZhou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arthaszyb/claude-enterprise-usage.git"
  },
  "homepage": "https://github.com/arthaszyb/claude-enterprise-usage#readme",
  "bugs": {
    "url": "https://github.com/arthaszyb/claude-enterprise-usage/issues"
  },
  "engines": { "vscode": "^1.94.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "claudeEnterpriseUsage.refresh", "title": "Claude Enterprise Usage: Refresh" },
      { "command": "claudeEnterpriseUsage.showDetails", "title": "Claude Enterprise Usage: Show details" }
    ],
    "configuration": {
      "title": "Claude Enterprise Usage",
      "properties": {
        "claudeEnterpriseUsage.refreshIntervalSeconds": {
          "type": "number", "default": 900, "minimum": 60,
          "description": "How often to check whether monthly usage can be refreshed. Monthly requests are capped at once every 15 minutes to avoid Anthropic rate limits."
        },
        "claudeEnterpriseUsage.showEstimatedCost": {
          "type": "boolean", "default": true,
          "description": "Show estimated month-to-date cost when the account returns it."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.94.0",
    "typescript": "^5.7.2",
    "@vscode/vsce": "3.9.2"
  }
}
